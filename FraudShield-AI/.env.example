# FraudShield AI - Environment Variables Example
# Copy this file to `.env` and adjust values if needed.
# The application runs entirely with local defaults if no .env is provided.

# SQLite database location (SQLAlchemy URL format)
DATABASE_URL=sqlite:///./data/fraudshield.db

# Base URL the Streamlit dashboard uses to reach the FastAPI backend
FRAUDSHIELD_API_URL=http://localhost:8000

# No external/paid API keys are required by this application.
